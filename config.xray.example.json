{
  "log": {
    "loglevel": "warning"
  },
  "dns": {
    "servers": [
      "tcp://1.1.1.1:53",
      "tcp://8.8.8.8:53",
      "https://1.1.1.1/dns-query"
    ],
    "queryStrategy": "UseIP"
  },
  "inbounds": [
    {
      "tag": "hev-socks-in",
      "port": 10808,
      "listen": "127.0.0.1",
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "routeOnly": true
      }
    },
    {
      "_comment": "专供 MosDNS 接入的本地内置 DNS 入站 (接收 127.0.0.1:10853 的 TCP/UDP 查询，路由至 dns-out 走节点出海)",
      "tag": "dns-in",
      "port": 10853,
      "listen": "127.0.0.1",
      "protocol": "dokodemo-door",
      "settings": {
        "address": "1.1.1.1",
        "port": 53,
        "network": "tcp,udp"
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy-xhttp",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "your-cdn-node.example.com",
            "port": 443,
            "users": [
              {
                "id": "00000000-0000-0000-0000-000000000000",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "your-cdn-node.example.com"
        },
        "xhttpSettings": {
          "path": "/xhttp-path",
          "mode": "packet-up"
        }
      }
    },
    {
      "tag": "dns-out",
      "protocol": "dns"
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {}
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "inboundTag": ["dns-in"],
        "outboundTag": "dns-out"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "proxy-xhttp"
      }
    ]
  }
}
