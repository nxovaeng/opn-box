#!/bin/sh

# PROVIDE: mosdns
# REQUIRE: pf_aliasd
# KEYWORD: shutdown

. /etc/rc.subr

name="mosdns"
rcvar="mosdns_enable"

load_rc_config $name

: ${mosdns_enable:="NO"}
: ${mosdns_config:="/usr/local/etc/mosdns/config.yaml"}
: ${mosdns_dir:="/usr/local/etc/mosdns"}
: ${mosdns_logfile:="/var/log/mosdns.log"}
: ${mosdns_pidfile:="/var/run/mosdns.pid"}

pidfile="${mosdns_pidfile}"
command="/usr/sbin/daemon"
procname="/usr/local/bin/mosdns"
command_args="-p ${pidfile} -o ${mosdns_logfile} -t ${name} ${procname} start -c ${mosdns_config} -d ${mosdns_dir}"

start_precmd="mosdns_prestart"

mosdns_prestart()
{
    if [ ! -f "${mosdns_config}" ]; then
        if [ -f "${mosdns_config}.sample" ]; then
            cp "${mosdns_config}.sample" "${mosdns_config}"
        else
            echo "Configuration file ${mosdns_config} not found!"
            return 1
        fi
    fi
    mkdir -p /var/log /var/run "${mosdns_dir}" "${mosdns_dir}/rule"
    touch "${mosdns_logfile}"
    # 确保 config.yaml 引用的规则文件存在，避免 domain_set 报 no such file or directory
    [ -f "${mosdns_dir}/rule/cn.txt" ] || touch "${mosdns_dir}/rule/cn.txt"
    [ -f "${mosdns_dir}/rule/gfw.txt" ] || touch "${mosdns_dir}/rule/gfw.txt"
    [ -f "${mosdns_dir}/rule/custom-direct.txt" ] || touch "${mosdns_dir}/rule/custom-direct.txt"
    [ -f "${mosdns_dir}/rule/custom-proxy.txt" ] || touch "${mosdns_dir}/rule/custom-proxy.txt"
}

run_rc_command "$1"
